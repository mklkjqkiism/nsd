<style>
  :root{
    --bg:#050507; --bg-soft:#0c0c11; --panel:#101016; --panel-2:#16161d; --line:#232330;
    --text:#e8e9f0; --text-dim:#8b8ca0; --accent:#00e5ff; --accent-2:#7c5cff;
    --danger:#ff3b5c; --ok:#3dffb4; --shadow:0 20px 60px rgba(0,0,0,.5);
  }
  *{margin:0;padding:0;box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{
    background:var(--bg); color:var(--text);
    font-family:"Noto Sans SC",system-ui,-apple-system,"PingFang SC","Microsoft YaHei",sans-serif;
    line-height:1.6; overflow-x:hidden; -webkit-font-smoothing:antialiased;
  }
  ::selection{background:var(--accent);color:#000}
  a{color:inherit;text-decoration:none}

  .bg-grid{position:fixed;inset:0;z-index:0;pointer-events:none;
    background:radial-gradient(ellipse 80% 50% at 50% -10%, rgba(124,92,255,.18), transparent 60%),
              radial-gradient(ellipse 60% 40% at 90% 110%, rgba(0,229,255,.10), transparent 60%);}
  .bg-grid::after{content:"";position:absolute;inset:0;
    background-image:linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),
                     linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px);
    background-size:56px 56px;
    mask-image:radial-gradient(ellipse 90% 70% at 50% 30%, #000 30%, transparent 75%);
    -webkit-mask-image:radial-gradient(ellipse 90% 70% at 50% 30%, #000 30%, transparent 75%);}

  /* 进场过渡 */
  #intro{position:fixed;inset:0;z-index:100;display:flex;align-items:center;justify-content:center;
    background:var(--bg);overflow:hidden;transition:opacity 1.1s ease, visibility 1.1s ease;}
  #intro.done{opacity:0;visibility:hidden}
  #intro .intro-orb{position:absolute;width:560px;height:560px;border-radius:50%;
    background:radial-gradient(circle, rgba(124,92,255,.22), rgba(0,229,255,.08) 45%, transparent 70%);
    filter:blur(30px);animation:introPulse 3s ease-in-out infinite;}
  @keyframes introPulse{0%,100%{transform:scale(1);opacity:.7}50%{transform:scale(1.15);opacity:1}}
  #intro .intro-text{position:relative;text-align:center;padding:0 24px;opacity:0;
    animation:introPop 1.5s cubic-bezier(.2,.8,.2,1) forwards;}
  @keyframes introPop{0%{opacity:0;transform:translateY(26px) scale(.96);letter-spacing:.5em}
    60%{opacity:1;transform:translateY(0) scale(1);letter-spacing:.05em}
    100%{opacity:1;transform:translateY(0) scale(1);letter-spacing:.05em}}
  #intro h1{font-size:clamp(2.2rem,7vw,4.4rem);font-weight:900;letter-spacing:.05em;
    background:linear-gradient(120deg,#e8e9f0 0%,var(--accent) 50%,var(--accent-2) 100%);
    -webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;}
  #intro .sub{margin-top:16px;color:var(--text-dim);font-size:clamp(.95rem,2.4vw,1.15rem);
    font-family:"JetBrains Mono",monospace;letter-spacing:.2em;
    animation:introSub 1s .5s cubic-bezier(.2,.8,.2,1) both;}
  @keyframes introSub{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}

  .site{position:relative;z-index:2}
  .hero{min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;
    text-align:center;padding:0 24px;position:relative;}
  .hero .nsd-logo{font-family:"JetBrains Mono",monospace;font-weight:700;
    font-size:clamp(4rem,16vw,9rem);letter-spacing:.08em;line-height:1;color:var(--text);
    text-shadow:0 0 30px rgba(0,229,255,.35),0 0 90px rgba(124,92,255,.25);}
  .hero .nsd-logo em{font-style:normal;color:var(--accent)}
  .hero .tagline{margin-top:18px;color:var(--text-dim);font-size:clamp(.9rem,2.4vw,1.1rem);letter-spacing:.18em;}
  .scroll-cue{position:absolute;bottom:34px;left:50%;transform:translateX(-50%);
    display:flex;flex-direction:column;align-items:center;gap:8px;color:var(--text-dim);
    font-size:.8rem;letter-spacing:.3em;}
  .scroll-cue .mouse{width:24px;height:38px;border:1.5px solid var(--line);border-radius:14px;position:relative;}
  .scroll-cue .mouse::after{content:"";position:absolute;top:7px;left:50%;width:3px;height:8px;border-radius:2px;
    background:var(--accent);transform:translateX(-50%);animation:wheel 1.8s ease infinite;}
  @keyframes wheel{0%{opacity:0;transform:translate(-50%,0)}30%{opacity:1}100%{opacity:0;transform:translate(-50%,12px)}}

  .section-wrap{padding:70px 20px 90px;position:relative}
  .section-head{max-width:980px;margin:0 auto 46px;text-align:center}
  .section-head .kicker{font-family:"JetBrains Mono",monospace;color:var(--accent);font-size:.82rem;
    letter-spacing:.35em;margin-bottom:12px;display:flex;align-items:center;justify-content:center;gap:14px;}
  .section-head .kicker::before,.section-head .kicker::after{content:"";height:1px;width:44px;
    background:linear-gradient(90deg,transparent,var(--line));}
  .section-head .kicker::after{background:linear-gradient(90deg,var(--line),transparent)}
  .section-head h2{font-size:clamp(1.7rem,5vw,2.6rem);font-weight:900;letter-spacing:.03em}

  .cards{max-width:980px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:26px}
  @media(max-width:820px){.cards{grid-template-columns:1fr}}
  .card{background:linear-gradient(180deg,var(--panel),var(--bg-soft));
    border:1px solid var(--line);border-radius:20px;padding:30px 30px 34px;
    position:relative;overflow:hidden;opacity:0;transform:translateY(40px);
    transition:opacity .8s ease,transform .8s cubic-bezier(.2,.7,.2,1),border-color .3s ease,box-shadow .3s ease;}
  .card.reveal{opacity:1;transform:translateY(0)}
  .card:hover{border-color:var(--accent-2);box-shadow:var(--shadow)}
  .card .glow{position:absolute;top:-60px;right:-60px;width:200px;height:200px;border-radius:50%;
    background:radial-gradient(circle,var(--glow,rgba(124,92,255,.16)),transparent 65%);pointer-events:none;}
  .card .card-ico{width:46px;height:46px;border-radius:12px;display:flex;align-items:center;justify-content:center;
    background:var(--panel-2);border:1px solid var(--line);margin-bottom:20px;}
  .card .card-ico svg{width:24px;height:24px}
  .card h3{font-size:1.35rem;font-weight:700;margin-bottom:8px}
  .card .desc{color:var(--text-dim);font-size:.92rem;margin-bottom:24px}

  .btn-group{display:grid;grid-template-columns:1fr 1fr;gap:14px}
  @media(max-width:420px){.btn-group{grid-template-columns:1fr}}
  .btn{display:flex;align-items:center;justify-content:center;gap:10px;padding:15px 18px;
    border-radius:14px;font-weight:700;font-size:1rem;border:1px solid var(--line);
    background:var(--panel-2);cursor:pointer;
    transition:transform .2s ease,border-color .2s ease,background .2s ease,box-shadow .2s ease;}
  .btn:hover{transform:translateY(-3px);border-color:var(--accent);box-shadow:0 10px 26px rgba(0,229,255,.16)}
  .btn:active{transform:translateY(0)}
  .btn svg{width:18px;height:18px}
  .btn .ext{font-family:"JetBrains Mono",monospace;color:var(--text-dim);font-size:.72rem;letter-spacing:.1em}
  .btn-4399{border-color:#3f3f4e}
  .btn-4399:hover{border-color:#ff5a1f}
  .btn-4399:hover svg{color:#ff5a1f}
  .btn-poki:hover{border-color:#00e5ff}
  .btn-poki:hover svg{color:#00e5ff}

  .card-form{display:flex;flex-direction:column;gap:14px}
  .card-form label{color:var(--text-dim);font-size:.86rem;letter-spacing:.06em}
  .key-row{display:flex;gap:10px}
  .key-row input{flex:1;background:var(--bg-soft);border:1px solid var(--line);border-radius:12px;
    padding:14px 16px;color:var(--text);font-family:"JetBrains Mono",monospace;
    font-size:1.05rem;letter-spacing:.2em;outline:none;transition:border-color .2s ease,box-shadow .2s ease;}
  .key-row input:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(0,229,255,.12)}
  .key-row .btn{flex:0 0 auto;border:none;background:linear-gradient(135deg,var(--accent-2),var(--accent));color:#000}
  .key-row .btn:hover{box-shadow:0 10px 26px rgba(124,92,255,.3)}
  .hint{color:var(--text-dim);font-size:.78rem;font-family:"JetBrains Mono",monospace;opacity:.7}
  .form-shake{animation:shake .4s ease}
  @keyframes shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-8px)}50%{transform:translateX(8px)}75%{transform:translateX(-5px)}}
  .form-error{color:var(--danger);font-size:.85rem;display:none}

  .modal{position:fixed;inset:0;z-index:80;display:none;align-items:center;justify-content:center;
    background:rgba(3,3,6,.85);backdrop-filter:blur(6px);}
  .modal.show{display:flex}
  .modal-box{background:linear-gradient(180deg,var(--panel-2),var(--panel));
    border:1px solid var(--line);border-radius:20px;padding:34px 38px;
    max-width:420px;width:calc(100% - 40px);text-align:center;
    transform:scale(.9);opacity:0;transition:transform .35s cubic-bezier(.2,.8,.2,1),opacity .35s ease;
    box-shadow:0 0 60px rgba(0,229,255,.08);}
  .modal.show .modal-box{transform:scale(1);opacity:1}
  .modal-box .m-ico{width:60px;height:60px;border-radius:50%;margin:0 auto 18px;display:flex;
    align-items:center;justify-content:center;border:1px solid var(--line)}
  .modal-box h4{font-size:1.2rem;font-weight:700;margin-bottom:8px}
  .modal-box p{color:var(--text-dim);font-size:.92rem;margin-bottom:22px}
  .modal .progress{height:6px;border-radius:99px;background:var(--bg-soft);overflow:hidden;margin-bottom:12px;}
  .modal .progress-bar{height:100%;width:0;border-radius:99px;background:linear-gradient(90deg,var(--accent-2),var(--accent))}
